<h1 class="text-2xl font-semibold">Your seasonal ski passes</h1>
<p>Each owned pass has its own season and expiry. Expired and undated historical passes are retained but do not count as current.</p>
<ul class="my-6 space-y-3">
  <% current_account.account_season_passes.includes(:season_pass).order(starts_on: :desc).each do |owned| %>
    <li class="rounded border p-3"><strong><%= owned.season_pass.name %></strong> · <%= owned.season_label.presence || 'Historical season unknown' %> · <%= owned.status_label %>
      <% unless owned.season_unknown? %><p><%= owned.starts_on %> through <%= owned.expires_on %></p><% end %>
      <%= button_to 'Remove this pass record', remove_owned_pass_path(owned.id), method: :delete, class: 'mt-2 text-sm text-red-700' %>
    </li>
  <% end %>
</ul>
<h2 class="text-xl font-semibold">Add or renew a pass</h2>
<%= form_with model: current_account, url: edit_profile_path, class: 'mt-4 space-y-4' do |form| %>
  <%= form.fields_for :account_season_passes, current_account.account_season_passes.new do |pass| %>
    <div><%= pass.label :season_pass_id, 'Pass type' %><%= pass.collection_select :season_pass_id, SeasonPass.order(:name), :id, :name, { prompt: 'Choose a pass' }, required: true %></div>
    <div><%= pass.label :season_label, 'Season label' %><%= pass.text_field :season_label, placeholder: '2026–27', required: true, autocomplete: 'off' %></div>
    <div><%= pass.label :starts_on, 'Valid from' %><%= pass.date_field :starts_on, required: true %></div>
    <div><%= pass.label :expires_on, 'Expires on' %><%= pass.date_field :expires_on, required: true %></div>
  <% end %>
  <%= form.submit 'Save seasonal pass', class: 'rounded bg-indigo-600 px-4 py-2 text-white' %>
<% end %>
