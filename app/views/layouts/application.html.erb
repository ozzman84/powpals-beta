<!DOCTYPE html>
<html lang='en' class="h-full bg-white">
  <head>
    <title>Powpals</title>
    <meta name="google-site-verification" content="2HGTPsZ5T2X-n7rItxjkOC45fTnnnYUEkw7Ehixe99c">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= favicon_link_tag asset_path("snowboarder2flavicon.png") %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="h-full">
    <div class="min-h-full">
      <div class="bg-gray-800 pb-32">
        <nav data-controller="menu" class="bg-gray-800">
          <div class="mx-auto max-w-7xl sm:px-6 lg:px-8">
            <div class="border-b border-gray-700">
              <div class="flex h-16 items-center justify-between px-4 sm:px-0">
                <div class="flex items-center">
                  <div class="flex-shrink-0">
                    <img class="h-14 w-14 flex-none object-contain" src="<%= asset_path("snowboarder-with-mountain.jpeg") %>" alt="PowPals">
                  </div>
                  <div class="hidden md:block">
                    <div class="ml-10 flex items-baseline space-x-4">
                      <% navigation_items.each do |item| %>
                        <%= link_to(item[:body], item[:href], class: navigation_class(item[:href]), 'aria-current': navigation_aria(item[:href])) %>
                      <% end %>
                    </div>
                  </div>
                </div>
                <div class="hidden md:block">
                  <div class="ml-4 flex items-center md:ml-6">
                    <button type="button" disabled title="Notifications are not available yet" class="relative rounded-full bg-gray-800 p-1 text-gray-400 hover:text-white focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-800">
                      <span class="absolute -inset-1.5"></span>
                      <span class="sr-only">View notifications</span>
                      <svg class="h-6 w-6 flex-none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                      </svg>
                    </button>
                    <div class="relative ml-3">
                      <div>
                        <button data-action="menu#toggleDesktopMenu" type="button" class="relative flex max-w-xs items-center rounded-full bg-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-800" id="user-menu-button" aria-expanded="false" aria-haspopup="true">
                          <span class="absolute -inset-1.5"></span>
                          <span class="sr-only">Open user menu</span>
                          <% if current_account&.user.nil? %>
                            <span class="sr-only">Open options</span>
                            <svg class="h-5 w-5 flex-none" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                              <path d="M10 3a1.5 1.5 0 110 3 1.5 1.5 0 010-3zM10 8.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3zM11.5 15.5a1.5 1.5 0 10-3 0 1.5 1.5 0 003 0z" />
                            </svg>
                          <% else %>
                            <%= render 'shared/avatar', user: current_account.user %>
                          <% end %>
                        </button>
                      </div>
                      <div data-menu-target="desktopMenu" class="hidden absolute right-0 z-10 mt-2 w-48 origin-top-right rounded-md bg-white py-1 shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none" role="menu" aria-orientation="vertical" aria-labelledby="user-menu-button" tabindex="-1">
                        <% if account_signed_in? %>
                          <%= link_to "Your Profile", user_path, class: "block px-4 py-2 text-sm text-gray-700", role: "menuitem", tabindex:"-1", id: "user-menu-item-0" %>
                          <%= link_to "Edit profile", edit_user_path, class: "block px-4 py-2 text-sm text-gray-700" %>
                          <%= button_to "Sign out", destroy_account_session_path, method: :delete, class: "block rounded-md px-3 py-2 text-sm text-gray-500 hover:bg-gray-100" %>
                        <% else %>
                          <a href="<%= new_account_session_path %>" class="block px-4 py-2 text-sm text-gray-700" role="menuitem" tabindex="-1" id="user-menu-item-2">Sign In</a>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="-mr-2 flex md:hidden">
                  <button data-action="menu#toggleMobileMenu" type="button" class="relative inline-flex items-center justify-center rounded-md bg-gray-800 p-2 text-gray-400 hover:bg-gray-700 hover:text-white focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-800" aria-label="Open main menu" aria-controls="mobile-menu" aria-expanded="false">
                    <span class="absolute -inset-0.5"></span>
                    <span class="sr-only">Open main menu</span>
                    <svg class="block h-6 w-6 flex-none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                    <svg class="hidden h-6 w-6 flex-none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
          <div data-menu-target="mobileMenu" class="hidden border-b border-gray-700 md:hidden" id="mobile-menu">
            <div class="space-y-1 px-2 py-3 sm:px-3">
              <% navigation_items.each do |item| %><%= link_to item[:body], item[:href], class: "block rounded-md px-3 py-2 text-base font-medium #{navigation_class(item[:href])}" %><% end %>
            </div>
            <div class="border-t border-gray-700 pb-3 pt-4">
              <div class="flex items-center px-5">
                <% if account_signed_in? && current_account.user %>
                  <div class="flex-shrink-0">
                      <%= render 'shared/avatar', user: current_account.user %>
                  </div>
                  <div class="ml-3 min-w-0 break-words">
                    <div class="text-base font-medium leading-none text-white"><%= current_account.user.full_name %></div>
                    <div class="text-sm font-medium leading-none text-gray-400"><%= current_account.email %></div>
                  </div>
                <% else %>
                  <span class="sr-only">Open options</span>
                  <svg class="h-5 w-5 flex-none" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M10 3a1.5 1.5 0 110 3 1.5 1.5 0 010-3zM10 8.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3zM11.5 15.5a1.5 1.5 0 10-3 0 1.5 1.5 0 003 0z" />
                  </svg>
                <% end %>

                <button type="button" disabled title="Notifications are not available yet" class="relative ml-auto flex-shrink-0 rounded-full bg-gray-800 p-1 text-gray-400 hover:text-white focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-800">
                  <span class="absolute -inset-1.5"></span>
                  <span class="sr-only">View notifications</span>
                  <svg class="h-6 w-6 flex-none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                  </svg>
                </button>
              </div>
              <div class="mt-3 space-y-1 px-2">
                <% if account_signed_in? %>
                  <a href="<%= edit_user_path %>" class="block rounded-md px-3 py-2 text-base font-medium text-gray-400 hover:bg-gray-700 hover:text-white">Edit profile</a>
                  <a href="<%= user_path %>" class="block rounded-md px-3 py-2 text-base font-medium text-gray-400 hover:bg-gray-700 hover:text-white">Dashboard</a>
                  <%= button_to "Sign out", destroy_account_session_path, method: :delete, class: "block rounded-md px-3 py-2 text-sm text-gray-500 hover:bg-gray-100" %>
                <% else %>
                  <a href="<%= new_account_session_path %>" class="block rounded-md px-3 py-2 text-base font-medium text-gray-400 hover:bg-gray-700 hover:text-white">Sign In</a>
                <% end %>
              </div>
            </div>
          </div>
        </nav>
        <header class="py-10">
          <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <%# <h1 class="text-3xl font-bold tracking-tight text-white">Dashboard</h1> %>
          </div>
        </header>
      </div>

      <main class="-mt-32" id="main-content">
        <div class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
          <div class="rounded-lg bg-white px-5 py-6 shadow sm:px-6">

            <% if demo_database? %><p class="mb-4 rounded bg-yellow-50 p-3 font-semibold">Demo data — this database contains fictional people, houses and stays.</p><% end %>
            <% flash.each do |_kind, message| %><p role="status" class="mb-4 break-words rounded border bg-white p-3"><%= message %></p><% end %>
            <%= yield %>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
