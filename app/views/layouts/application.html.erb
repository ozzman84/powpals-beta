<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
  <head>
    <title>PowPals</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag 'tailwind', 'inter-font', 'data-turbo-track': 'reload' %>
    <%= stylesheet_link_tag 'application', 'data-turbo-track': 'reload' %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-full text-gray-900">
    <nav aria-label="Main navigation" class="flex flex-wrap items-center gap-4 bg-gray-800 p-4 text-white">
      <%= link_to 'PowPals', root_path, class: 'text-xl font-bold' %>
      <% if account_signed_in? %>
        <%= link_to 'My houses', users_lodgings_path %>
        <%= link_to 'Profile', user_path %>
        <%= link_to 'Passes', edit_profile_path %>
        <%= link_to 'People', users_path %>
        <%= button_to 'Sign out', destroy_account_session_path, method: :delete %>
      <% else %>
        <%= link_to 'Sign in', new_account_session_path %>
        <%= link_to 'Register', new_account_registration_path %>
      <% end %>
    </nav>
    <div class="mx-auto max-w-6xl space-y-4 p-4 sm:p-6">
      <% flash.each do |_kind, message| %>
        <p role="status" class="rounded border bg-white p-3"><%= message %></p>
      <% end %>
      <%= yield %>
    </div>
  </body>
</html>
