<% compact = local_assigns.fetch(:compact, false) %>
<% limit = compact ? 2 : 8 %>
<% anonymous = [total - people.size, 0].max %>
<div class="attendee-stack <%= 'attendee-stack-compact' if compact %>" data-controller="attendee-stack">
  <% if total.positive? %>
    <button type="button" class="attendee-stack-trigger" data-action="attendee-stack#open" aria-label="<%= label %>: <%= total %> people" aria-haspopup="dialog">
      <% people.first(limit).each do |person| %>
        <span class="attendee-stack-person">
          <% if person[:user] %><%= render 'shared/avatar', user: person[:user], height: '8', width: '8' %><% else %><span class="attendee-stack-initials" aria-hidden="true"><%= person[:name].split.filter_map(&:first).first(2).join %></span><% end %>
          <span class="attendee-stack-tooltip"><%= person[:name] %><%= ' (guest)' if person[:guest] %></span>
        </span>
      <% end %>
      <span class="attendee-stack-count" aria-label="<%= total %> people total"><%= total %></span>
    </button>
    <dialog class="attendee-dialog" data-attendee-stack-target="dialog" data-action="click->attendee-stack#backdropClose close->attendee-stack#restoreFocus" aria-label="<%= label %>">
      <header class="attendee-dialog-heading"><h2 class="text-base font-semibold"><%= label %></h2><button type="button" data-action="attendee-stack#close" class="rounded border px-3 py-2 text-sm" aria-label="Close people dialog">Close</button></header>
      <ul class="attendee-dialog-grid">
        <% people.each do |person| %>
          <li class="attendee-dialog-person">
            <% if person[:user] %><%= render 'shared/avatar', user: person[:user], height: '16', width: '16' %><% else %><span class="attendee-dialog-initials" aria-hidden="true"><%= person[:name].split.filter_map(&:first).first(2).join %></span><% end %>
            <span class="text-sm font-medium"><%= person[:name] %></span>
            <% if person[:guest] %><span class="text-xs text-gray-500">Guest</span><% end %>
          </li>
        <% end %>
      </ul>
      <% if anonymous.positive? %><p class="px-5 pb-4 text-sm text-gray-600"><%= pluralize(anonymous, 'additional guest') %> · names not provided</p><% end %>
      <footer class="border-t px-5 py-3 text-sm text-gray-600"><%= pluralize(total, 'person') %> total</footer>
    </dialog>
  <% elsif !compact %>
    <span class="attendee-stack-count" aria-label="0 people total">0</span>
  <% end %>
</div>
