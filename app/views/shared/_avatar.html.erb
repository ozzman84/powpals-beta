<% size_class = avatar_size_classes(local_assigns.fetch(:height, '10'), local_assigns.fetch(:width, '10')) %>
<div class="<%= size_class %> flex-none overflow-hidden rounded-full" data-avatar>
  <% if user.avatar_url.present? %>
    <img class="block h-full w-full object-cover" src="<%= user.avatar_url %>" alt="<%= user.initials %>">
  <% else %>
    <div class="flex h-full w-full items-center justify-center bg-gray-100 text-sm font-medium text-gray-600"><%= user.initials %></div>
  <% end %>
</div>
