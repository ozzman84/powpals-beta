<header class="relative mb-6 border-b border-gray-200 pb-5">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0 max-w-full break-words"><h1 class="text-xl font-semibold leading-6 text-gray-900"><%= @lodging.title %></h1><p class="mt-1 text-sm text-gray-500"><%= @lodging.full_address %></p></div>
    <% if policy(@lodging).update? %><%= link_to 'Edit house', edit_users_lodging_path(@lodging), class: 'rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-gray-300' %><% end %>
  </div>
  <nav aria-label="House navigation" class="mt-4 flex flex-wrap gap-x-6 gap-y-3">
    <% house_navigation(@lodging).each do |label, path| %>
      <%= link_to label, path, class: "border-b-2 px-1 pb-2 text-sm font-medium #{current_page?(path) ? 'border-indigo-500 text-indigo-600' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'}", aria: { current: ('page' if current_page?(path)) } %>
    <% end %>
  </nav>
</header>
