<header class="space-y-3 border-b pb-4">
  <h1 class="text-2xl font-bold"><%= @lodging.title %></h1>
  <p><%= @lodging.full_address %></p>
  <nav aria-label="House navigation" class="flex flex-wrap gap-4">
    <%= link_to 'House overview', users_lodging_path(@lodging) %>
    <%= link_to 'Rooms', users_lodging_rooms_path(@lodging) %>
    <%= link_to 'Shared calendar', users_lodging_calendars_path(@lodging) %>
    <% if policy(@lodging).view_operations? %>
      <%= link_to 'Seasons & guest fees', users_lodging_house_seasons_path(@lodging) %>
    <% end %>
    <%= link_to 'My stays', my_calendar_users_lodging_calendars_path(@lodging) %>
    <% if policy(@lodging).update? %>
      <%= link_to 'Edit house', edit_users_lodging_path(@lodging) %>
    <% end %>
  </nav>
</header>
