<%= render 'shared/header' %>
<h2 class="text-xl font-semibold"><%= @current_date.strftime('%B %Y') %></h2>
<nav aria-label="Calendar months" class="flex flex-wrap gap-4">
  <%= link_to 'Previous month', users_lodging_calendars_path(@lodging, start_date: @current_date - 1.month) %>
  <%= link_to 'This month', users_lodging_calendars_path(@lodging) %>
  <%= link_to 'Next month', users_lodging_calendars_path(@lodging, start_date: @current_date + 1.month) %>
</nav>
<div class="grid grid-cols-7 gap-1 text-center">
  <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |day| %><div class="text-xs font-semibold"><%= day %></div><% end %>
  <% @lodging_calendars.each do |date, avatars| %>
    <div class="min-h-20 rounded border bg-white p-1">
      <time datetime="<%= date.iso8601 %>" class="text-sm"><%= date.day %></time>
      <p class="text-xs"><%= avatars.size %> staying</p>
      <div class="flex flex-wrap justify-center gap-1">
        <% avatars.compact.each do |avatar| %><img src="<%= avatar %>" alt="Roommate staying" class="h-6 w-6 rounded-full"><% end %>
      </div>
    </div>
  <% end %>
</div>
