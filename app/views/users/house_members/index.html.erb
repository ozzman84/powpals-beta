<%= render 'shared/header' %>
<%= render 'shared/errors' %>
<%= render 'shared/notices' %>
<h2 class="text-xl font-semibold">Seasonal member directory</h2>
<%= form_with url: users_lodging_house_members_path(@lodging), method: :get, class: 'my-4 flex flex-wrap gap-3' do |form| %>
  <%= form.label :season_id, 'Season' %><%= form.collection_select :season_id, @seasons, :id, :name, selected: @season&.id %><%= form.submit 'View season' %>
<% end %>
<p class="my-4 text-sm">Profiles and passes carry across seasons. House details stay private. Members choose whether to share contact details.</p>
<% if @season %>
  <ul role="list" class="roommate-grid grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
    <% @members.each do |membership| %>
      <% person = membership.user %>
      <li class="roommate-card col-span-1 flex min-w-0 flex-col rounded-lg bg-white shadow" data-roommate-card="<%= membership.roommate_id %>">
        <%= render 'shared/roommate_identity', roommate: membership.roommate %>
        <div class="flex-1 space-y-3 px-5 pb-5 text-sm">
        <p class="text-center text-xs text-gray-500"><%= membership.status.humanize %></p>
        <ul><% person.account.account_season_passes.where('starts_on <= ? AND expires_on >= ?', @season.ends_on, @season.starts_on).includes(:season_pass).each do |owned| %><li><%= owned.season_pass.name %> · <%= owned.season_label %></li><% end %></ul>
        <p class="mt-2 whitespace-pre-line">Responsibilities: <%= membership.responsibilities.presence || 'Not assigned' %></p>
        <p class="mt-2 whitespace-pre-line">Pets: <%= membership.pets.presence || 'Not provided' %></p>
        <p class="mt-2 whitespace-pre-line">Pet rules: <%= membership.pet_rules.presence || 'Not confirmed' %></p>
        <p class="mt-2 whitespace-pre-line">Preferences: <%= membership.preferences %></p>
        <% if person == current_account.user || policy(@lodging).manage_roommates? %>
          <details class="border-t border-slate-200 pt-3"><summary class="font-semibold text-indigo-700">Edit member details</summary>
          <%= form_with model: membership, url: users_lodging_house_member_path(@lodging, membership, season_id: @season.id), class: 'mt-4 space-y-3' do |form| %>
            <% if policy(@lodging).manage_roommates? %>
              <div><%= form.label :status %><%= form.select :status, HouseSeasonMembership.statuses.keys %></div>
              <div><%= form.label :responsibilities %><%= form.text_area :responsibilities, class: 'w-full rounded border' %></div>
              <div><%= form.label :pet_rules %><%= form.text_area :pet_rules, class: 'w-full rounded border' %></div>
            <% end %>
            <div><%= form.label :pets %><%= form.text_area :pets, class: 'w-full rounded border' %></div>
            <div><%= form.label :preferences, 'Optional preferences: games, drinks, colors or other details' %><%= form.text_area :preferences, class: 'w-full rounded border' %></div>
            <% if person == current_account.user %><div><%= form.check_box :share_contact %><%= form.label :share_contact, 'Share my email and phone with this house for this season' %></div><% end %>
            <%= form.submit 'Save member details', class: 'rounded bg-indigo-600 p-2 text-white' %>
          <% end %>
          </details>
        <% end %>
        </div>
        <%= render 'shared/roommate_contacts', roommate: membership.roommate, season_membership: membership %>
      </li>
    <% end %>
  </ul>
  <% if policy(@lodging).manage_roommates? %>
    <h3 class="mt-6 font-semibold">Include an already accepted house member in this season</h3>
    <%= form_with url: users_lodging_house_members_path(@lodging, season_id: @season.id), class: 'mt-3 flex flex-wrap gap-3' do |form| %><%= form.collection_select :roommate_id, @lodging.roommates.where(access_state: 'active').where.not(role: 'guest').includes(:user), :id, :directory_name, {}, class: 'w-full max-w-full rounded border' %><%= form.submit 'Add to season' %><% end %>
  <% end %>
<% if policy(@lodging).manage_roommates? %>
  <section class="house-panel mt-8 p-4"><h3 class="text-lg font-semibold">House access and permission roles</h3><p class="my-3 text-sm">Revoking access removes private house access without deleting historical records. Season responsibilities do not grant permissions.</p>
    <% @lodging.roommates.where.not(role: 'guest').includes(:user).each do |member| %>
      <%= form_with model: member, url: users_lodging_roommate_path(@lodging, member), class: 'my-3 flex flex-wrap items-end gap-3 rounded border p-3' do |form| %>
        <span class="min-w-0 break-words"><%= member.user.display_name %></span><div><%= form.label :role, for: "member-role-#{member.id}" %><%= form.select :role, Roommate.roles.keys - ['guest'], {}, id: "member-role-#{member.id}" %></div><div><%= form.label :access_state, 'House access', for: "member-access-#{member.id}" %><%= form.select :access_state, Roommate.access_states.keys, {}, id: "member-access-#{member.id}" %></div><%= form.submit 'Save access', class: 'rounded border p-2' %>
      <% end %>
    <% end %>
  </section>
<% end %>
<% else %><p>Create a house season before preparing its roster.</p><% end %>
