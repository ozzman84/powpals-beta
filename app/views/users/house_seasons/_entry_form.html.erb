<h3 class="text-xl font-semibold">Add a charge or expense</h3>
<%= form_with url: users_lodging_house_season_house_ledger_entries_path(@lodging, @season), scope: :house_ledger_entry, class: 'space-y-3' do |form| %>
  <div><%= form.label :kind %><%= form.select :kind, [['Guest fee', 'guest_fee'], ['Shared expense', 'expense']] %></div>
  <div><%= form.label :description %><%= form.text_field :description, required: true, autocomplete: 'off' %></div>
  <div><%= form.label :month_on, 'Accounting month' %><%= form.select :month_on, @season.months.map { |date| [date.strftime('%b %Y'), date.iso8601] } %></div>
  <div><%= form.label :amount, 'Amount (USD)' %><%= form.number_field :amount, min: '0.01', step: '0.01', required: true, autocomplete: 'off' %></div>
  <%= form.submit 'Add ledger entry', class: 'rounded bg-indigo-700 p-2 text-white' %>
<% end %>
