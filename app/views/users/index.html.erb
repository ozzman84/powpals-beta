<h1 class="text-2xl font-bold">People</h1>
<p>The people directory is available now. Friendships, messaging, and meetups are not implemented yet.</p>
<ul class="grid gap-3 sm:grid-cols-2">
  <% @users.each do |user| %>
    <li class="rounded border bg-white p-4"><p class="font-semibold"><%= user.first_name %> <%= user.last_name %></p><p><%= user.ride_type %> · <%= user.level %></p></li>
  <% end %>
</ul>
