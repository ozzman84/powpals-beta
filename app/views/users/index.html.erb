<div class="border-b border-gray-200 bg-white px-4 py-5 sm:px-6">
  <div class="-ml-4 -mt-4 flex flex-wrap items-center justify-between sm:flex-nowrap">
    <div class="ml-4 mt-4">
      <div class="flex items-center">
        <%= render 'shared/avatar', user: current_account.user %>

        <div class="ml-4">
          <h3 class="text-base font-semibold leading-6 text-gray-900"><%= current_account.user.full_name %></h3>
          <p class="text-sm text-gray-500">
            <span><%= current_account.user.ride_type %></span>
          </p>
        </div>
      </div>
    </div>
    <div class="ml-4 mt-4"><h1 class="text-xl font-semibold">PowPals</h1><p class="text-sm text-gray-500">The skier directory</p></div>
  </div>
</div>

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
  <% @users.each do |user| %>

    <div class="relative flex items-center space-x-3 rounded-lg border border-gray-300 bg-white px-6 py-5 shadow-sm focus-within:ring-2 focus-within:ring-indigo-500 focus-within:ring-offset-2 hover:border-gray-400">
      <%= render 'shared/avatar', user: user %>

      <div class="min-w-0 flex-1">
        <div>

          <p class="text-sm font-medium text-gray-900"><%= user.full_name %></p>
          <p class="truncate text-sm text-gray-500"><%= user.ride_type %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>
