<section id="rooms-today" aria-labelledby="rooms-today-heading" class="house-panel overflow-hidden">
  <header class="house-panel-heading px-4 py-3">
    <div class="flex items-start justify-between gap-3"><h2 id="rooms-today-heading" class="text-base font-semibold text-gray-900">Rooms · tonight</h2><span class="flex-none rounded-full bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600"><%= pluralize(@bed_availability.values.sum(&:available), 'free space') %></span></div>
  </header>
  <% if @rooms.empty? %><p class="p-5 text-sm text-gray-500">No rooms configured yet.</p><% end %>
  <div class="divide-y divide-gray-100">
    <% @rooms.each do |room| %>
      <section class="px-4 py-3" aria-label="<%= room.name %>">
        <h3 class="break-words text-sm font-semibold text-gray-900"><%= room.name %></h3>
        <% if room.beds.empty? %><p class="mt-2 text-xs text-gray-500">No sleeping spaces configured.</p><% end %>
        <ul class="mt-2 space-y-1">
          <% room.beds.each do |bed| %>
            <% availability = @bed_availability.fetch(bed.id) %>
            <li data-bed-availability="<%= bed.id %>" class="min-w-0 rounded-lg bg-gray-50 px-2 py-2">
              <div class="flex items-start gap-2">
                <span class="mt-0.5 flex-none text-gray-500"><%= render 'shared/bed_icon', bed: bed %></span>
                <div class="min-w-0 flex-1"><p class="break-words text-sm font-medium text-gray-900"><%= bed.inventory_name %></p><p class="mt-0.5 text-xs text-gray-500"><%= availability.available %> of <%= availability.capacity %> spaces free<%= ' · Temporary' if bed.temporary? %></p></div>
                <span class="flex-none rounded-full px-2 py-1 text-[10px] font-semibold <%= { 'Available' => 'bg-green-50 text-green-800', 'Partly taken' => 'bg-yellow-50 text-yellow-800', 'Taken' => 'bg-red-50 text-red-700' }.fetch(availability.status) %>"><%= availability.status %></span>
              </div>
              <% if availability.occupants.any? %>
                <ul class="mt-1 space-y-1" aria-label="Confirmed occupants">
                  <% availability.occupants.each do |assignment| %>
                    <% person = assignment.guest_stay ? assignment.guest_stay.guest : assignment.user %>
                    <li class="flex min-w-0 items-center gap-2">
                      <% if person %><%= render 'shared/avatar', user: person, height: '6', width: '6' %><% else %><span class="flex h-6 w-6 flex-none items-center justify-center rounded-full bg-gray-200 text-xs text-gray-500" aria-hidden="true">G</span><% end %>
                      <p class="min-w-0 break-words text-xs text-gray-700"><%= assignment.guest_stay ? "#{assignment.guest_stay.guest_name} (guest)" : assignment.user.display_name %> · <%= pluralize(assignment.spaces, 'space') %></p>
                    </li>
                  <% end %>
                </ul>
              <% end %>
              <% if availability.pending_count.positive? %><p class="mt-1 text-xs text-yellow-800"><%= pluralize(availability.pending_count, 'pending request') %></p><% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
  <footer class="flex flex-wrap gap-x-4 gap-y-2 border-t border-gray-100 px-4 py-3 text-xs font-semibold text-indigo-600"><%= link_to 'View all rooms', users_lodging_rooms_path(@lodging) %><%= link_to 'Requests & assignments', users_lodging_rooms_path(@lodging, anchor: 'bed-requests') %></footer>
</section>
