<h1 class="text-2xl font-bold">My houses</h1>
<%= link_to 'New house', new_users_lodging_path, class: 'inline-block rounded bg-indigo-700 px-4 py-2 text-white' %>
<% if @lodgings.empty? %><p>You do not belong to a house yet. Create one or ask its manager to add you.</p><% end %>
<ul class="space-y-3">
  <% @lodgings.each do |lodging| %>
    <li class="rounded border bg-white p-4">
      <%= link_to lodging.title, users_lodging_path(lodging), class: 'text-lg font-semibold' %>
      <p><%= lodging.full_address %></p>
      <p><%= lodging.status.humanize %></p>
      <% if policy(lodging).destroy? && !lodging.archived? %>
        <%= button_to 'Archive house', users_lodging_path(lodging), method: :delete, data: { turbo_confirm: 'Archive this house?' } %>
      <% end %>
    </li>
  <% end %>
</ul>
