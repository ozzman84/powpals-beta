<div class="house-overview">
<%= render 'shared/header' %>
<%= render 'shared/errors' %>
<%= render 'shared/notices' %>

<main>
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-2xl grid-cols-1 grid-rows-1 items-start gap-x-8 gap-y-8 lg:mx-0 lg:max-w-none lg:grid-cols-3">
      <div class="min-w-0 lg:col-start-3 lg:row-end-1">
        <%= render 'room_availability' %>
      </div>

      <div class="min-w-0 lg:col-span-2 lg:row-span-2 lg:row-end-2">
        <%= render 'weekly_attendance' %>
      </div>

      <section class="house-panel p-4 lg:col-start-3"><h2 class="text-sm font-semibold">Activities</h2><ul class="mt-6 space-y-4">
        <% @lodging.calendars.includes(:user).order(updated_at: :desc).limit(5).each do |stay| %>
          <li class="flex gap-3 rounded-lg p-3 ring-1 ring-gray-200"><%= render 'shared/avatar', user: stay.user %><div class="min-w-0 break-words text-sm"><p class="font-medium"><%= stay.user.first_name %> · <%= stay.status.humanize %></p><time class="text-gray-500"><%= stay.date %></time><p class="text-gray-500"><%= stay.guest_count %> guests · <%= stay.cars %> cars</p></div></li>
        <% end %>
      </ul><% if policy(@lodging).view_operations? %><%= link_to 'House rules, fees and expenses', users_lodging_house_seasons_path(@lodging), class: 'mt-4 inline-block text-sm font-semibold text-indigo-600' %><% end %></section>
    </div>
  </div>
</main>
<section id="house-members" class="mx-auto mt-6 max-w-7xl"><h2 class="text-xl font-semibold">Roommates</h2><ul role="list" class="roommate-grid mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
  <% @lodging.roommates.includes(user: :account).each do |membership| %>
    <li class="roommate-card relative col-span-1 flex min-w-0 flex-col rounded-lg bg-white shadow" data-roommate-card="<%= membership.id %>">
      <%= render 'shared/roommate_identity', roommate: membership %>
      <%= render 'shared/roommate_modal', roommate: membership, season_membership: @roommate_season_details[membership.id] %>
      <%= render 'shared/roommate_contacts', roommate: membership, season_membership: @roommate_season_details[membership.id] %>
    </li>
  <% end %>
</ul>
<% if policy(@lodging).manage_roommates? %>
  <h3 class="mt-6 font-semibold">Invite a roommate</h3>
  <p class="mt-2 text-sm">Access begins after acceptance. Share the generated link privately; no email is sent automatically.</p>
  <%= form_with url: users_lodging_roommates_path(@lodging), scope: :roommate, class: 'mt-4 flex flex-wrap items-end gap-3' do |form| %>
    <div><%= form.label :email %><%= form.email_field :email, required: true, class: 'max-w-full rounded border p-2' %></div>
    <div><%= form.label :house_season_id, 'Season (optional)' %><%= form.collection_select :house_season_id, @lodging.house_seasons.order(starts_on: :desc), :id, :name, include_blank: 'House access only' %></div>
    <div><%= form.label :role %><%= form.select :role, (Roommate.roles.keys - ['guest']).map { |role| [role.humanize, role] } %></div>
    <%= form.submit 'Create invitation', class: 'rounded bg-indigo-600 p-2 text-white' %>
  <% end %>
  <% @lodging.house_invitations.where(accepted_at: nil, revoked_at: nil).where('expires_at > ?', Time.current).each do |invitation| %>
    <div class="mt-3 flex flex-wrap gap-3"><span><%= invitation.email %> · expires <%= invitation.expires_at.to_date %></span><%= button_to 'Revoke invitation', users_lodging_roommate_path(@lodging, invitation), method: :delete, class: 'text-red-700' %></div>
  <% end %>
<% end %></section>

</div>
