<%= render 'shared/header' %>
<p><%= @lodging.description %></p>
<p>Capacity: <%= @lodging.max_guests %> people. Parking: <%= @lodging.max_cars || 'not set' %>.</p>
<p>Rental season: <%= @lodging.season_start || 'not set' %> to <%= @lodging.season_end || 'not set' %>.</p>
<h2 class="text-xl font-semibold">This week</h2>
<div class="overflow-x-auto">
  <table class="w-full text-left">
    <thead><tr><th class="p-2">Day</th><th class="p-2">Staying</th><th class="p-2">Away</th><th class="p-2">Guests</th><th class="p-2">Cars</th></tr></thead>
    <tbody>
      <% @lodging.calendars.this_week.each do |date, counts| %>
        <tr class="border-t"><td class="p-2"><%= date.strftime('%a %b %d') %></td><td class="p-2"><%= counts[:staying] %></td><td class="p-2"><%= counts[:away] %></td><td class="p-2"><%= counts[:guests] %></td><td class="p-2"><%= counts[:cars] %></td></tr>
      <% end %>
    </tbody>
  </table>
</div>
<h2 class="text-xl font-semibold">Roommates</h2>
<ul><% @lodging.roommates.includes(:user).each do |membership| %><li><%= membership.user.first_name %> <%= membership.user.last_name %> — <%= membership.role&.humanize || 'Roommate' %></li><% end %></ul>
<% if policy(@lodging).manage_roommates? %>
  <h2 class="text-xl font-semibold">Add an existing account to this house</h2>
  <%= form_with url: users_lodging_roommates_path(@lodging), scope: :roommate, class: 'flex flex-wrap items-end gap-3' do |form| %>
    <div><%= form.label :user_id, 'Person' %><%= form.collection_select :user_id, User.where.not(id: @lodging.user_ids).order(:first_name), :id, :full_name, { prompt: 'Choose a person' }, required: true %></div>
    <div><%= form.label :role %><%= form.select :role, Roommate.roles.keys.map { |role| [role.humanize, role] }, selected: 'roommate' %></div>
    <%= form.submit 'Add roommate', class: 'rounded bg-indigo-700 p-2 text-white' %>
  <% end %>
<% end %>
