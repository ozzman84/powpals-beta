<%= render 'shared/header' %>
<%= render 'shared/errors' %>
<%= render 'shared/notices' %>

<main>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-2xl grid-cols-1 grid-rows-1 items-start gap-x-8 gap-y-8 lg:mx-0 lg:max-w-none lg:grid-cols-3">
      <!-- Rooms summary -->
      <div class="lg:col-start-3 lg:row-end-1">
        <h2 class="sr-only">Summary</h2>
        <div class="rounded-lg bg-gray-50 shadow-sm ring-1 ring-gray-900/5">
          <dl class="flex flex-wrap">
            <div class="flex-auto pl-6 pt-6">
              <dt class="text-sm font-semibold leading-6 text-gray-900">Rooms</dt>
            </div>
            <div class="flex-none self-end px-6 pt-4">
              <dt class="sr-only">Status</dt>
              <dd class="rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-600 ring-1 ring-inset ring-green-600/20">Inventory</dd>
            </div>
            <% @lodging.rooms.each do |room| %>
              <div class="mt-4 flex w-full flex-none gap-x-4 px-6">
                <dt class="flex-none">
                  <span class="sr-only">Status</span>
                  <svg xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 640 512"><!--! Font Awesome Free 6.4.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2023 Fonticons, Inc. --><path d="M176 256c44.11 0 80-35.89 80-80s-35.89-80-80-80-80 35.89-80 80 35.89 80 80 80zm352-128H304c-8.84 0-16 7.16-16 16v144H64V80c0-8.84-7.16-16-16-16H16C7.16 64 0 71.16 0 80v352c0 8.84 7.16 16 16 16h32c8.84 0 16-7.16 16-16v-48h512v48c0 8.84 7.16 16 16 16h32c8.84 0 16-7.16 16-16V240c0-61.86-50.14-112-112-112z" /></svg>
                </dt>
                <dd class="text-sm leading-6 text-gray-500"><%= room.name %></dd>
              </div>
            <% end %>
          </dl>
        </div>
      </div>

      <!-- Lodging Details -->
      <div class="-mx-4 px-4 py-8 shadow-lg ring-1 ring-gray-900/5 sm:mx-0 sm:rounded-lg sm:px-8 sm:pb-14 lg:col-span-2 lg:row-span-2 lg:row-end-2 xl:px-16 xl:pb-20 xl:pt-16">
        <h2 class="text-base font-semibold leading-6 text-gray-900">Season</h2>
        <dl class="mt-6 grid grid-cols-1 text-sm leading-6 sm:grid-cols-2">
          <div class="sm:pr-4">
            <dt class="inline text-gray-500">Start Date:</dt>
            <dd class="inline text-gray-700"><time datetime="<%= @lodging.season_start %>"><%= @lodging.season_start&.strftime('%B %d, %Y') || 'Not set' %></time></dd>
          </div>
          <div class="mt-2 sm:mt-0 sm:pl-4">
            <dt class="inline text-gray-500">End Date:</dt>
            <dd class="inline text-gray-700"><time datetime="<%= @lodging.season_end %>"><%= @lodging.season_end&.strftime('%B %d, %Y') || 'Not set' %></time></dd>
          </div>
        </dl>
        <p class="mt-6 text-sm text-gray-500">Capacity: <%= @lodging.max_guests %> people. Parking: <%= @lodging.max_cars || 'not set' %>.</p>
        <p class="mt-2 text-sm"><%= @lodging.description %></p>
        <div class="overflow-x-auto"><table class="mt-8 w-full whitespace-nowrap text-left text-sm leading-6">
          <colgroup>
            <col class="w-full">
            <col>
            <col>
            <col>
          </colgroup>
          <thead class="border-b border-gray-200 text-gray-900">
            <tr>
              <th scope="col" class="px-0 py-3 font-semibold">This week</th>
              <th scope="col" class="hidden py-3 pl-8 pr-0 text-right font-semibold sm:table-cell">Staying</th>
              <th scope="col" class="hidden py-3 pl-8 pr-0 text-right font-semibold sm:table-cell">Away</th>
              <th scope="col" class="py-3 pl-8 pr-0 text-right font-semibold">Guests</th>
              <th scope="col" class="py-3 pl-8 pr-0 text-right font-semibold">Cars</th>
            </tr>
          </thead>
          <tbody>
            <% @lodging.calendars.this_week.each do |date, counts| %>
              <tr class="border-b border-gray-100">
                <td class="max-w-0 px-0 py-5 align-top">
                  <div class="truncate font-medium text-gray-900"><%= date.strftime('%A') %> - <%= date.day.ordinalize %></div>
                </td>
                <td class="hidden py-5 pl-8 pr-0 text-right align-top tabular-nums text-gray-700 sm:table-cell">
                  <div class="truncate text-gray-500">
                    <div class="flex -space-x-3 rtl:space-x-reverse justify-end">
                      <% counts[:avatar_urls].each do |avatar| %>
                        <img class="w-8 h-8 border-2 border-white rounded-full dark:border-gray-800" src="<%= avatar %>" alt="">
                      <% end %>
                      <span class="flex items-center justify-center w-8 h-8 text-xs font-medium text-white bg-gray-700 border-2 border-white rounded-full hover:bg-gray-600 dark:border-gray-800"><%= counts[:staying] %></span>
                    </div>
                  </div>
                </td>
                <td class="hidden py-5 pl-8 pr-0 text-center align-center tabular-nums text-gray-700 sm:table-cell"><%= counts[:away] %></td>
                <td class="py-5 pl-8 pr-0 text-center align-center tabular-nums text-gray-700"><%= counts[:guests] %></td>
                <td class="py-5 pl-8 pr-0 text-center tabular-nums text-gray-700"><%= counts[:cars] %></td>
              </tr>
            <% end %>
          </tbody>
        </table></div>
      </div>

      <section class="lg:col-start-3"><h2 class="text-sm font-semibold">Activities</h2><ul class="mt-6 space-y-4">
        <% @lodging.calendars.includes(:user).order(updated_at: :desc).limit(5).each do |stay| %>
          <li class="flex gap-3 rounded-lg p-3 ring-1 ring-gray-200"><%= render 'shared/avatar', user: stay.user %><div class="text-sm"><p class="font-medium"><%= stay.user.first_name %> · <%= stay.status.humanize %></p><time class="text-gray-500"><%= stay.date %></time><p class="text-gray-500"><%= stay.guest_count %> guests · <%= stay.cars %> cars</p></div></li>
        <% end %>
      </ul><% if policy(@lodging).view_operations? %><%= link_to 'House rules, fees and expenses', users_lodging_house_seasons_path(@lodging), class: 'mt-4 inline-block text-sm font-semibold text-indigo-600' %><% end %></section>
    </div>
  </div>
</main>
<section id="house-members" class="mt-6 border-t pt-6"><h2 class="text-xl font-semibold">Roommates</h2><ul class="mt-4 grid gap-4 sm:grid-cols-2">
  <% @lodging.roommates.includes(:user).each do |membership| %><li class="flex items-center gap-3 rounded-lg border p-4"><%= render 'shared/avatar', user: membership.user %><div><p class="font-medium"><%= membership.user.first_name %> <%= membership.user.last_name %></p><p class="text-sm text-gray-500"><%= membership.role&.humanize || 'Roommate' %></p></div></li><% end %>
</ul>
<% if policy(@lodging).manage_roommates? %>
  <h3 class="mt-6 font-semibold">Add an existing account to this house</h3>
  <%= form_with url: users_lodging_roommates_path(@lodging), scope: :roommate, class: 'mt-4 flex flex-wrap items-end gap-3' do |form| %>
    <div><%= form.label :user_id, 'Person' %><%= form.collection_select :user_id, User.where.not(id: @lodging.user_ids).order(:first_name), :id, :full_name, { prompt: 'Choose a person' }, required: true %></div>
    <div><%= form.label :role %><%= form.select :role, Roommate.roles.keys.map { |role| [role.humanize, role] }, selected: 'roommate' %></div>
    <%= form.submit 'Add roommate', class: 'rounded bg-indigo-600 p-2 text-white' %>
  <% end %>
<% end %></section>
