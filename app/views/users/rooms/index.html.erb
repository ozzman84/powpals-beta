<%= render 'shared/header' %>
<h2 class="text-xl font-semibold">Rooms and beds</h2>
<% if @rooms.empty? %><p>No rooms have been added.</p><% end %>
<ul class="space-y-3">
  <% @rooms.includes(:beds).each do |room| %>
    <li class="rounded border bg-white p-4">
      <h3 class="font-semibold"><%= room.name %></h3>
      <ul><% room.beds.each do |bed| %><li><%= bed.size&.humanize %> <%= bed.style&.humanize %> · sleeps <%= bed.capacity %></li><% end %></ul>
      <% if policy(@lodging).manage_rooms? %><%= button_to 'Remove room', users_lodging_room_path(@lodging, room), method: :delete, data: { turbo_confirm: 'Remove this room and its beds?' } %><% end %>
    </li>
  <% end %>
</ul>
<% if policy(@lodging).manage_rooms? %><h2 class="text-xl font-semibold">Add room</h2><%= render 'form', lodging: @lodging %><% end %>
