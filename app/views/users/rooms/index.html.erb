<%= render 'shared/header' %>
<%= render partial: 'shared/errors' %>
<%= render partial: 'shared/notices' %>
<p class="mb-4 text-sm">Sleeping inventory is guidance. Temporary spaces count toward the displayed guidance. Bed requests are managed separately.</p>
<% if @lodging.layout_reference_url.present? %><p class="mb-4"><%= link_to 'Room diagram / layout reference', @lodging.layout_reference_url, rel: 'noreferrer noopener', target: '_blank', class: 'text-indigo-600' %></p><% end %>

<div class="">
  <ul role="list" class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
    <% @rooms.each do |room| %>
    <li class="col-span-1 flex flex-col divide-y divide-gray-200 rounded-lg bg-white text-center shadow">
      <div class="flex flex-1 flex-col p-8">

        <h3 class="mt-6 text-sm font-medium text-gray-900"><%= "#{room.name.to_s.capitalize} #{room.room_type.to_s.humanize}" %><span class="block text-xs text-gray-500"><%= room.beds.count %> beds</span></h3>
        <p class="mt-3 whitespace-pre-line text-sm"><%= room.layout_notes %></p>
        <% if policy(@lodging).manage_rooms? %>
          <%= form_with model: room, url: users_lodging_room_path(@lodging, room), class: 'mt-3 space-y-2' do |form| %>
            <%= form.label :name, 'Room name' %><%= form.text_field :name, class: 'w-full rounded border' %>
            <%= form.label :layout_notes, 'Layout and sleeping instructions' %><%= form.text_area :layout_notes, class: 'w-full rounded border' %><%= form.submit 'Save room', class: 'rounded border p-2' %>
          <% end %>
        <% end %>
        <% room.beds.each do |bed| %>
          <div class="mt-5">
              <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Inventory</span>
            <div class="rounded-md bg-gray-50 px-6 py-5 sm:flex sm:items-start sm:justify-between">
              <div class="sm:flex sm:items-start">

                <div class="mt-3 sm:ml-4 sm:mt-0">
                  <div class="text-sm font-medium text-gray-900"><%= bed.inventory_name %> <%= "(temporary)" if bed.temporary? %><p class="text-xs"><%= bed.capacity || Bed::CAPACITY[bed.size.to_sym] %> sleeping spaces</p><p class="whitespace-pre-line"><%= bed.notes %></p>
                    <% if policy(@lodging).manage_rooms? %><%= form_with model: bed, url: users_lodging_room_bed_path(@lodging, room, bed), class: 'mt-2 space-y-2' do |form| %>
                      <div><%= form.label :label, 'Bed label' %><%= form.text_field :label, class: 'w-full rounded border' %></div>
                      <div><%= form.label :size %><%= form.select :size, Bed.sizes.keys %></div>
                      <div><%= form.label :style %><%= form.select :style, Bed.styles.keys %></div>
                      <div><%= form.check_box :temporary %><%= form.label :temporary, 'Temporary sleeping space' %></div>
                      <div><%= form.label :notes %><%= form.text_area :notes, class: 'w-full rounded border' %></div><%= form.label :capacity, 'Sleeping spaces', for: "bed-capacity-#{bed.id}" %><%= form.number_field :capacity, id: "bed-capacity-#{bed.id}", value: bed.capacity || Bed::CAPACITY[bed.size.to_sym], min: 1, class: 'w-20' %><%= form.submit 'Save bed spaces', class: 'rounded border p-1 text-xs' %><% end %><% end %></div>

                </div>
              </div>

            </div>
          </div>

        <% end %>
        <% if policy(@lodging).manage_rooms? %>
          <%= form_with url: users_lodging_room_beds_path(@lodging, room), scope: :bed, class: 'mt-5 space-y-3 rounded border p-3' do |form| %>
            <h4 class="font-semibold">Add a sleeping space</h4>
            <div><%= form.label :label, for: "new-bed-#{room.id}-label" %><%= form.text_field :label, id: "new-bed-#{room.id}-label", class: 'w-full rounded border' %></div>
            <div><%= form.label :size, for: "new-bed-#{room.id}-size" %><%= form.select :size, Bed.sizes.keys, {}, id: "new-bed-#{room.id}-size" %></div>
            <div><%= form.label :style, for: "new-bed-#{room.id}-style" %><%= form.select :style, Bed.styles.keys, {}, id: "new-bed-#{room.id}-style" %></div>
            <div><%= form.check_box :temporary, id: "new-bed-#{room.id}-temporary" %><%= form.label :temporary, 'Temporary space', for: "new-bed-#{room.id}-temporary" %></div>
            <%= form.submit 'Add sleeping space', class: 'rounded border p-2' %>
          <% end %>
        <% end %>
      </div>
      <% if policy(@lodging).manage_rooms? %><div class="border-t p-4"><%= button_to 'Remove room', users_lodging_room_path(@lodging, room), method: :delete, class: 'font-semibold text-red-700' %></div><% end %>
    </li>
    <% end %>
  </ul>
</div>

<% if policy(@lodging).manage_rooms? %><section class="house-panel mt-8 p-4"><h2 class="mb-4 text-xl font-semibold">Add a room</h2><%= render partial: 'form', locals: { lodging: @lodging } %></section><% end %>
