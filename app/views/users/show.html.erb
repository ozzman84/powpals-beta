<h1 class="text-2xl font-bold"><%= [@user.preferred_name.presence || @user.first_name, @user.last_name].compact.join(' ') %></h1>
<p><%= @user.ride_type %> · <%= @user.level %></p>
<p><%= [@user.city, @user.state].compact_blank.join(', ') %></p>
<p><%= @user.about %></p>
<%= link_to 'Edit profile', edit_user_path %>
<h2 class="text-xl font-semibold">My passes</h2>
<ul><% current_account.season_passes.each do |pass| %><li><%= pass.name %></li><% end %></ul>
<h2 class="text-xl font-semibold">My houses</h2>
<ul><% @user.lodgings.each do |lodging| %><li><%= link_to lodging.title, users_lodging_path(lodging) %></li><% end %></ul>
<%= link_to 'See mountain forecasts', root_path %>
