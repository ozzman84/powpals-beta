<div class="border-b border-gray-200 pb-6 sm:flex sm:items-center sm:justify-between">
  <div class="flex min-w-0 items-center gap-4"><%= render 'shared/avatar', user: @user, height: '16', width: '16' %><div class="min-w-0 break-words"><h1 class="text-2xl font-semibold text-gray-900"><%= [@user.preferred_name.presence || @user.first_name, @user.last_name].compact.join(' ') %></h1><p class="text-sm text-gray-500"><%= [@user.level&.humanize, @user.ride_type&.humanize].compact.join(' · ') %></p><p class="text-sm text-gray-500"><%= [@user.city, @user.state].compact_blank.join(', ') %></p></div></div>
  <%= link_to 'Edit profile', edit_user_path, class: 'mt-4 inline-block rounded-md border px-3 py-2 text-sm font-semibold sm:mt-0' %>
</div>
<div class="mt-6 grid min-w-0 grid-cols-1 gap-6 lg:grid-cols-3">
  <aside class="space-y-6">
    <section class="rounded-lg bg-gray-50 p-5 ring-1 ring-gray-200"><h2 class="font-semibold">About</h2><p class="mt-2 whitespace-pre-line text-sm text-gray-600"><%= @user.about.presence || 'Add a little about yourself in your profile.' %></p><% if @user.instagram_url.present? %><p class="mt-2 break-words text-sm">Instagram: <%= @user.instagram_url %></p><% end %></section>
    <section class="rounded-lg bg-gray-50 p-5 ring-1 ring-gray-200"><h2 class="font-semibold">Passes</h2><ul class="mt-2 space-y-2"><% current_account.account_season_passes.includes(:season_pass).each do |owned| %><li><%= owned.season_pass.name %> · <%= owned.season_label.presence || 'Historical season unknown' %> · <%= owned.status_label %><% if owned.expires_on %> · expires <%= owned.expires_on %><% end %></li><% end %></ul><%= link_to 'Manage passes', edit_profile_path, class: 'mt-3 inline-block text-sm font-semibold text-indigo-600' %></section>
    <% if @user.house_access? %><section class="rounded-lg bg-gray-50 p-5 ring-1 ring-gray-200"><h2 class="font-semibold">Ski Housing</h2><ul class="mt-2 space-y-2"><% @user.lodgings.each do |house| %><li><%= link_to house.title, users_lodging_path(house), class: 'text-indigo-600' %></li><% end %></ul><%= link_to 'My houses', users_lodgings_path, class: 'mt-3 inline-block text-sm font-semibold text-indigo-600' %></section><% end %>
  </aside>
  <section class="min-w-0 lg:col-span-2"><h2 class="text-xl font-semibold">Resorts</h2><p class="mt-2 text-sm text-gray-500">Your pass resorts and skier plans for the next 10 days.</p><%= render 'shared/resort_table', resorts: @resorts %></section>
</div>
