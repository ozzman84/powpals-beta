#!/usr/bin/env ruby
# frozen_string_literal: true

# Run with rbenv exec bundle exec ruby bin/export-bear-lodge /private/backup/path.json
require 'json'
require 'pg'

abort 'Provide a new private snapshot path' unless ARGV.size == 1
snapshot_path = File.expand_path(ARGV.fetch(0))
project_path = File.expand_path('..', __dir__)
abort 'Store private snapshots outside the repository' if snapshot_path.start_with?("#{project_path}/")

connection = PG.connect(dbname: 'powpals_beta_development')
begin
  connection.exec('BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY')
  house = connection.exec_params('SELECT * FROM lodgings WHERE id = $1 AND title = $2', [1, 'Bear Lodge']).to_a
  abort 'Expected Bear Lodge at historical house ID 1' unless house.size == 1
  queries = {
    'lodgings' => 'SELECT * FROM lodgings WHERE id = 1',
    'users' => 'SELECT * FROM users WHERE id IN (SELECT user_id FROM roommates WHERE lodging_id = 1 ' \
      'UNION SELECT user_id FROM calendars WHERE lodging_id = 1)',
    'accounts' => 'SELECT * FROM accounts WHERE id IN (SELECT account_id FROM users WHERE id IN ' \
      '(SELECT user_id FROM roommates WHERE lodging_id = 1 UNION SELECT user_id FROM calendars WHERE lodging_id = 1))',
    'roommates' => 'SELECT * FROM roommates WHERE lodging_id = 1',
    'rooms' => 'SELECT * FROM rooms WHERE lodging_id = 1',
    'beds' => 'SELECT * FROM beds WHERE room_id IN (SELECT id FROM rooms WHERE lodging_id = 1)',
    'calendars' => 'SELECT * FROM calendars WHERE lodging_id = 1'
  }
  tables = queries.transform_values { |query| connection.exec(query).to_a }
  File.open(snapshot_path, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
    file.write(JSON.pretty_generate(version: 1, tables: tables))
  end
  connection.exec('COMMIT')
  puts JSON.pretty_generate(path: snapshot_path, counts: tables.transform_values(&:size))
ensure
  connection.close
end
